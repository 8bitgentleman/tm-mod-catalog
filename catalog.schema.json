{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/8bitgentleman/tm-mod-catalog/catalog.schema.json",
  "title": "Tricky Madness mod catalog",
  "description": "What the mod manager can install. Generated by release_shared/catalog_entry.py; see MOD_MANAGER_PLAN.md (Design > Catalog).",
  "type": "object",
  "required": ["schema", "manager_min", "sources", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema": { "enum": [1, 2], "description": "2 = some entry has parts (multi-part builds); managers <= 0.1.4 refuse it" },
    "manager_min": { "$ref": "#/$defs/semver" },
    "updated": { "type": "string", "format": "date-time" },
    "sources": {
      "description": "MEGA folders the zips live in. One public folder link each, stored once. link=null means not shared yet: entries under it are listed but cannot be installed.",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/source" }
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+){0,3}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "source": {
      "type": "object",
      "required": ["mega_path", "link"],
      "additionalProperties": false,
      "properties": {
        "mega_path": { "type": "string", "pattern": "^/" },
        "link": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^https://mega\\.nz/folder/[A-Za-z0-9_-]+#[A-Za-z0-9_-]+$" }
          ]
        }
      }
    },
    "installed_file": {
      "type": "object",
      "required": ["member", "sha256", "size"],
      "additionalProperties": false,
      "properties": {
        "member": { "type": "string", "description": "path inside the zip" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 0 },
        "exec": { "const": true, "description": "set the executable bit after extracting (Mac)" }
      }
    },
    "part": {
      "description": "one zip of a multi-part entry; version = the release it last changed in",
      "type": "object",
      "required": ["version", "source", "path", "file", "size", "sha256", "files"],
      "additionalProperties": false,
      "properties": {
        "version": { "$ref": "#/$defs/semver" },
        "source": { "$ref": "#/$defs/build/properties/source" },
        "path": { "$ref": "#/$defs/build/properties/path" },
        "file": { "$ref": "#/$defs/build/properties/file" },
        "size": { "$ref": "#/$defs/build/properties/size" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "files": { "$ref": "#/$defs/build/properties/files" }
      }
    },
    "parted_build": {
      "description": "a build made of the entry's parts, installed together; the manager downloads only the ones not already installed unchanged",
      "type": "object",
      "required": ["parts"],
      "additionalProperties": false,
      "properties": {
        "parts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "any_build": { "oneOf": [ { "$ref": "#/$defs/build" }, { "$ref": "#/$defs/parted_build" } ] },
    "build": {
      "type": "object",
      "required": ["source", "path", "file", "size", "sha256", "files"],
      "additionalProperties": false,
      "properties": {
        "source": { "$ref": "#/$defs/id" },
        "path": { "type": "string", "description": "subfolder inside the source folder; empty = its root" },
        "file": { "type": "string", "pattern": "\\.zip$" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "files": {
          "description": "install path (relative to the game folder) -> where it comes from in the zip",
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^(BepInEx|Maps)/[^\\\\]+$", "not": { "pattern": "(^|/)\\.\\.(/|$)" } },
          "additionalProperties": { "$ref": "#/$defs/installed_file" }
        }
      }
    },
    "entry": {
      "type": "object",
      "required": ["id", "name", "kind", "status", "author", "version", "description", "thumb", "video", "requires", "tested_tm_build", "builds"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["maps", "plugin", "framework"] },
        "status": {
          "description": "stable = listed normally; beta/alpha = listed with that badge; unreleased = hidden unless the player turns on 'show unreleased'",
          "enum": ["stable", "beta", "alpha", "unreleased"]
        },
        "author": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/semver" },
        "description": { "type": "string" },
        "thumb": { "type": ["string", "null"], "pattern": "^thumbs/[a-z0-9-]+\\.(png|jpg)$" },
        "video": { "type": ["string", "null"], "pattern": "^https://" },
        "config": {
          "description": "BepInEx/config/ file names this entry's plugins write on first run (named by plugin GUID, so not derivable from the DLL); the manager's settings screen edits these",
          "type": "array",
          "items": { "type": "string", "pattern": "^[^/\\\\]+\\.cfg$" }
        },
        "requires": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "type": "string", "pattern": "^>=[0-9]+(\\.[0-9]+){0,3}$" }
        },
        "tested_tm_build": {
          "description": "Steam build id the release was checked against; null = not recorded",
          "type": ["string", "null"], "pattern": "^[0-9]+$"
        },
        "parts": {
          "description": "schema 2: named zips that builds list by id, so a code fix ships without re-uploading the content",
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/part" }
        },
        "builds": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "mac": { "$ref": "#/$defs/any_build" },
            "windows": { "$ref": "#/$defs/any_build" },
            "any": { "$ref": "#/$defs/any_build" }
          },
          "not": { "anyOf": [ { "required": ["any", "mac"] }, { "required": ["any", "windows"] } ] }
        }
      }
    }
  }
}
